# SteadyHand Bridge Service Environment Configuration

# Host and Port
STEADYHAND_HOST=127.0.0.1
STEADYHAND_PORT=8765

# Adapter Mode: mock | replay | uno_q
STEADYHAND_MODE=mock

# Replay fixture path (used when STEADYHAND_MODE=replay)
STEADYHAND_REPLAY_FIXTURE=fixtures/synthetic/signals/pure_sine_5hz_100hz.json

# Pairing Authentication Token (kept out of URLs and public logs)
STEADYHAND_AUTH_TOKEN=steadyhand-dev-token-secret

# Allowed Origins (comma-separated). Extension origin chrome-extension://... can be added here
STEADYHAND_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8765,http://127.0.0.1:8765,chrome-extension://*

# Hardware Serial / Device Port (used when STEADYHAND_MODE=uno_q)
STEADYHAND_DEVICE_PORT=COM3
STEADYHAND_DEVICE_BAUD=115200

# Optional Haptics Feature Flag (defaults to false)
STEADYHAND_HAPTICS_ENABLED=false
